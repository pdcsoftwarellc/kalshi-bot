# Copy to .env. Keep credentials out of Git and chat.
# Default launch: .venv/bin/python bot.py (paper trading, public Kalshi prices).
API_TENNIS_KEY=

# Production credentials; unused in paper mode.
# RSA or Ed25519 PEM; paths resolve relative to this project, and ~ is supported.
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=

# Separate credentials for Kalshi demo execution (--live without --prod).
DEMO_KALSHI_API_KEY=
DEMO_KALSHI_PRIVATE_KEY_PATH=
HYBRID_PRICING=false

# Small evaluation limits, not a profitability recommendation.
MIN_EDGE_PCT=0.05
MIN_CONFIDENCE=0.60
MIN_POINTS_OBSERVED=10
MAX_CONTRACTS_PER_SIGNAL=1
MAX_CONTRACTS_PER_MATCH=5
MAX_TOTAL_EXPOSURE=25
NET_EDGE_MIN_DOLLARS=0.10
MATCH_STOP_LOSS_DOLLARS=3
PORTFOLIO_STOP_LOSS_DOLLARS=5
PROFIT_TARGET_DOLLARS=5

ARTIFACTS_DIR=data/artifacts
ALIASES_PATH=data/aliases.json
ATP_RAW_DIR=data/raw/tennis_atp
# Local ledger for paper trades. The bot creates it on first run.
DB_PATH=data/paper-trading.db
MARKET_REFRESH_SECS=60
REST_POLL_SECS=3
WEB_PORT=8765
LOG_LEVEL=INFO
